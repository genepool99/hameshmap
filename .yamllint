---
extends: default

ignore: |
  .git/
  node_modules/
  tests/manifest/fixtures/

rules:
  line-length:
    max: 160
    level: warning
  # Home Assistant manifests and GitHub workflows use bare `on:` and yes/no-free
  # booleans; keep truthy strict for values but allow the workflow key.
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start: disable
